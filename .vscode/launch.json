      "args": ["--source", "0", "--recipe", "4,4,4", "--record-session"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Can inspection - demo without a camera",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/run.py",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
