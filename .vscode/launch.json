{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current Windows — 12-pack counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/windows/run.py",
      "args": [
        "--source",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Current Windows — CPU counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/windows/run.py",
      "args": [
        "--source",
        "0",
        "--device",
        "cpu"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pi only — Hailo-8 counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/pi/run.py",
      "args": [
        "--backend",
        "hailo",
        "--source",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Legacy — color-only demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/legacy/color_baseline/run.py",
      "args": [
        "--demo"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
