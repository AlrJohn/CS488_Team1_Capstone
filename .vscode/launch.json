{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current Windows \u00e2\u20ac\u201d 12-pack counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/windows/run.py",
      "args": [
        "--source",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Current Windows \u00e2\u20ac\u201d CPU counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/windows/run.py",
      "args": [
        "--source",
        "0",
        "--device",
        "cpu"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pi only \u00e2\u20ac\u201d Hailo-8 counter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/pi/run.py",
      "args": [
        "--backend",
        "hailo",
        "--source",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
