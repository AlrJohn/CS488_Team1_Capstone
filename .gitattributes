# Keep documentation line endings consistent and Office/media files binary.
*.md text eol=lf
*.json text eol=lf
*.docx binary
*.pptx binary
*.jpeg binary
*.jpg binary
*.heic binary
*.HEIC binary
*.m4a binary
*.pt binary
*.hef binary
*.png binary
*.py text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.txt -text
